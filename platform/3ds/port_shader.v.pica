; Colosseum3DS port bring-up: position and per-vertex color, no game assets.
.fvec projection[4]
.fvec modelView[4]
.constf constants(0.0, 1.0, 0.0, 0.0)
.alias one constants.yyyy
.out outPosition position
.out outColor color
.alias vertex v0
.alias vertexColor v1

.proc main
    mov r0.xyz, vertex
    mov r0.w, one
    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0
    dp4 outPosition.x, projection[0], r1
    dp4 outPosition.y, projection[1], r1
    dp4 outPosition.z, projection[2], r1
    dp4 outPosition.w, projection[3], r1
    mov outColor.xyz, vertexColor
    mov outColor.w, one
    end
.end
