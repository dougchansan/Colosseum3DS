; GPU-skinned title vertices (second DVLE of title_shader.shbin).
; Each bind-space vertex is moved by one placed bone of a per-draw palette,
; lit with the HSD raster colour rules and given affine UVs. Mirrors
; c3_skin_eval in src/skin_uniforms.c; the uniforms are described in
; include/colosseum3ds/skin_uniforms.h. Not named *.v.pica on purpose: the
; Makefile builds it together with title_shader.v.pica so both programs share
; one code blob and switching between them uploads no shader code.
.fvec mvp[4]
.fvec bones[60]
.fvec uvRows[4]
.fvec lightVec[4]
.fvec lightColor[4]
.fvec lightAtten[4]
.fvec base
.fvec mode
.fvec alphaMode
.constf consts(0.0, 1.0, 0.00392156863, 0.000000000001)
.alias zero consts.xxxx
.alias one consts.yyyy
.alias inv255 consts.zzzz
.alias tiny consts.wwww
.out outPosition position
.out outColor color
.out outTexCoord texcoord0
.out outTexCoord2 texcoord1
.alias inPos v0
.alias inNormal v1
.alias inUV v2
.alias inUV2 v3
.alias inColor v4
.alias inSlot v5
.entry skin_main

.proc skin_main
    ; Palette slot * 6 is stored per vertex.
    mova a0.x, inSlot.x
    mov r0.xyz, inPos
    mov r0.w, one
    dp4 r1.x, bones[a0.x], r0
    dp4 r1.y, bones[a0.x+1], r0
    dp4 r1.z, bones[a0.x+2], r0
    mov r1.w, one
    dp4 outPosition.x, mvp[0], r1
    dp4 outPosition.y, mvp[1], r1
    dp4 outPosition.z, mvp[2], r1
    dp4 outPosition.w, mvp[3], r1

    ; World normal, renormalised (a zero normal stays zero).
    dp3 r2.x, bones[a0.x+3], inNormal
    dp3 r2.y, bones[a0.x+4], inNormal
    dp3 r2.z, bones[a0.x+5], inNormal
    dp3 r3.x, r2, r2
    max r3.x, tiny, r3.x
    rsq r3.x, r3.x
    mul r2.xyz, r2.xyz, r3.xxx

    ; Light sum: intensity = max(N.L, 0) / (1 + a*d + b*d*d); infinite lights
    ; store a unit vector with w = 0 and no attenuation.
    mov r7, zero
    mul r4.xyz, lightVec[0].www, r1.xyz
    add r4.xyz, lightVec[0].xyz, -r4.xyz
    dp3 r5.x, r4, r4
    max r5.x, tiny, r5.x
    rsq r5.y, r5.x
    mul r5.z, r5.x, r5.y
    dp3 r6.x, r2, r4
    mul r6.x, r6.x, r5.y
    max r6.x, zero, r6.x
    mul r5.w, lightAtten[0].x, r5.z
    mul r8.x, lightAtten[0].y, r5.x
    add r5.w, r5.w, r8.x
    add r5.w, one, r5.w
    rcp r5.w, r5.w
    mul r6.x, r6.x, r5.w
    mul r8, lightColor[0], r6.xxxx
    add r7, r7, r8

    mul r4.xyz, lightVec[1].www, r1.xyz
    add r4.xyz, lightVec[1].xyz, -r4.xyz
    dp3 r5.x, r4, r4
    max r5.x, tiny, r5.x
    rsq r5.y, r5.x
    mul r5.z, r5.x, r5.y
    dp3 r6.x, r2, r4
    mul r6.x, r6.x, r5.y
    max r6.x, zero, r6.x
    mul r5.w, lightAtten[1].x, r5.z
    mul r8.x, lightAtten[1].y, r5.x
    add r5.w, r5.w, r8.x
    add r5.w, one, r5.w
    rcp r5.w, r5.w
    mul r6.x, r6.x, r5.w
    mul r8, lightColor[1], r6.xxxx
    add r7, r7, r8

    mul r4.xyz, lightVec[2].www, r1.xyz
    add r4.xyz, lightVec[2].xyz, -r4.xyz
    dp3 r5.x, r4, r4
    max r5.x, tiny, r5.x
    rsq r5.y, r5.x
    mul r5.z, r5.x, r5.y
    dp3 r6.x, r2, r4
    mul r6.x, r6.x, r5.y
    max r6.x, zero, r6.x
    mul r5.w, lightAtten[2].x, r5.z
    mul r8.x, lightAtten[2].y, r5.x
    add r5.w, r5.w, r8.x
    add r5.w, one, r5.w
    rcp r5.w, r5.w
    mul r6.x, r6.x, r5.w
    mul r8, lightColor[2], r6.xxxx
    add r7, r7, r8

    mul r4.xyz, lightVec[3].www, r1.xyz
    add r4.xyz, lightVec[3].xyz, -r4.xyz
    dp3 r5.x, r4, r4
    max r5.x, tiny, r5.x
    rsq r5.y, r5.x
    mul r5.z, r5.x, r5.y
    dp3 r6.x, r2, r4
    mul r6.x, r6.x, r5.y
    max r6.x, zero, r6.x
    mul r5.w, lightAtten[3].x, r5.z
    mul r8.x, lightAtten[3].y, r5.x
    add r5.w, r5.w, r8.x
    add r5.w, one, r5.w
    rcp r5.w, r5.w
    mul r6.x, r6.x, r5.w
    mul r8, lightColor[3], r6.xxxx
    add r7, r7, r8

    ; lit = clamp(base + sum * mode.w + vertex_rgb * mode.x)
    mul r8, inv255, inColor
    mul r7, mode.wwww, r7
    add r7, base, r7
    mul r9.xyz, mode.xxx, r8.xyz
    add r7.xyz, r7.xyz, r9.xyz
    max r7, zero, r7
    min r7, one, r7
    ; rgb *= 1 + (vertex - 1) * mode.y
    add r9, -one, r8
    mul r10.xyz, mode.yyy, r9.xyz
    add r10.xyz, one, r10.xyz
    mul outColor.xyz, r7.xyz, r10.xyz
    ; alpha = (alphaMode.x + alphaMode.y * lit.a) * (1 + (vertex.a - 1) * mode.z)
    mul r11.x, alphaMode.y, r7.w
    add r11.x, alphaMode.x, r11.x
    mul r10.w, mode.z, r9.w
    add r10.w, one, r10.w
    mul outColor.w, r11.x, r10.w

    ; Affine UVs: dot(row, (u, v, 0, 1)). All output components are written.
    mov r12.xy, inUV.xy
    mov r12.zw, consts.xy
    dp4 outTexCoord.x, uvRows[0], r12
    dp4 outTexCoord.y, uvRows[1], r12
    mov outTexCoord.zw, consts.xy
    mov r13.xy, inUV2.xy
    mov r13.zw, consts.xy
    dp4 outTexCoord2.x, uvRows[2], r13
    dp4 outTexCoord2.y, uvRows[3], r13
    mov outTexCoord2.zw, consts.xy
    end
.end
